<?xml version="1.0"?>
<odoo>

    <!-- ============================================================ -->
    <!-- FORM VIEW: db.backup                                          -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="view_db_backup_form">
        <field name="name">db.backup.form</field>
        <field name="model">db.backup</field>
        <field name="arch" type="xml">
            <form string="Respaldo de Base de Datos">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_instances" icon="fa-server"
                                invisible="instance_count == 0">
                            <field name="instance_count" widget="statinfo" string="Instancias"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del respaldo..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Archivo">
                            <field name="filename" placeholder="mi_empresa_backup.zip"/>
                            <field name="file_path" readonly="1"/>
                            <field name="file_size" readonly="1"/>
                            <field name="file_exists" widget="boolean_button" readonly="1"
                                   options="{'terminology': {'true_title': 'Archivo encontrado', 'false_title': 'Archivo NO encontrado'}}"/>
                        </group>
                        <group string="Configuración de Restauración">
                            <field name="odoo_version"/>
                            <field name="master_password" password="True"/>
                        </group>
                    </group>
                    <group string="⚠️ Instrucciones" col="1">
                        <div class="alert alert-info" role="alert">
                            <strong>¿Cómo agregar un archivo de respaldo?</strong>
                            <ol>
                                <li>Copia tu archivo <code>.zip</code> (exportado desde el Database Manager de Odoo) al directorio:</li>
                                <li><code>microsaas_db_restore/static/db_backups/</code></li>
                                <li>Registra el nombre del archivo en el campo <strong>Archivo ZIP</strong> arriba.</li>
                                <li>El campo <strong>Archivo Existe</strong> se pondrá en verde cuando el archivo sea detectado.</li>
                            </ol>
                        </div>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1" colspan="2"
                               placeholder="Descripción del contenido, cliente, fecha de respaldo..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- LIST VIEW: db.backup                                          -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="view_db_backup_list">
        <field name="name">db.backup.list</field>
        <field name="model">db.backup</field>
        <field name="arch" type="xml">
            <list string="Respaldos de Base de Datos" decoration-danger="file_exists == False">
                <field name="name"/>
                <field name="filename"/>
                <field name="odoo_version"/>
                <field name="file_size"/>
                <field name="file_exists" widget="boolean_button" string="Disponible"/>
                <field name="instance_count" string="Instancias"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION                                                        -->
    <!-- ============================================================ -->
    <record model="ir.actions.act_window" id="action_db_backup">
        <field name="name">Respaldos de BD</field>
        <field name="res_model">db.backup</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- MENU (dentro del menú de micro_saas)                         -->
    <!-- ============================================================ -->
    <!-- Ajusta el parent al menu_id correcto de tu módulo micro_saas -->
    <menuitem id="menu_db_backup"
              name="Respaldos de BD"
              parent="micro_saas.menu_micro_saas_root"
              action="action_db_backup"
              sequence="20"/>

</odoo>
