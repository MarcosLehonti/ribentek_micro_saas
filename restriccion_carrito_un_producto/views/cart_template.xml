<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Notificación en el carrito (Existente) -->
    <template id="restriccion_notificacion_carrito" inherit_id="website_sale.cart_lines">
        <xpath expr="//div[@id='cart_products']" position="before">
            <t t-if="request.params.get('notification') == 'un_producto'">
                <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <strong>¡Solo se permite un producto por compra!</strong>
                    Si deseas adquirir más suscripciones, debes realizar
                    una compra separada por cada una.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"/>
                </div>
            </t>
        </xpath>
    </template>

    <!-- 2. Ocultar selector de cantidad en la LISTA DEL CARRITO -->
    <template id="hide_quantity_cart_lines" inherit_id="website_sale.cart_lines">
        <xpath expr="//div[@name='website_sale_cart_line_quantity']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//div[@name='website_sale_cart_line_quantity']" position="after">
            <span class="text-muted small">Cant: 1</span>
        </xpath>
    </template>

    <!-- 3. Ocultar selector de cantidad en la PÁGINA DEL PRODUCTO -->
    <template id="hide_quantity_product_page" inherit_id="website_sale.product">
        <xpath expr="//section[@id='product_detail']" position="inside">
            <style>
                /* Ocultar el selector de cantidad y forzar a que no ocupe espacio visual */
                .css_quantity { display: none !important; }
            </style>
        </xpath>
    </template>
</odoo>