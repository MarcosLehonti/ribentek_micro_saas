<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_saas" model="ir.ui.view">
        <field name="name">account.move.form.inherit.saas</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
             <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="subscription_months" readonly="1" invisible="subscription_months == 0"/>
                <field name="subscription_users" readonly="1" invisible="subscription_users == 0"/>
            </xpath>
        </field>
    </record>
</odoo>
