#. module: odoo_website_helpdesk
#: model:mail.template,body_html:odoo_website_helpdesk.ticket_canceled
msgid ""
"<p>\n"
"                    Dear\n"
"                    <t t-out=\"object.customer_id.name\"></t>\n"
"                    <br>\n"
"                    Your Ticket\n"
"                    <t t-out=\"object.name\"></t>\n"
"                    is Canceled Due to Some Reasons\n"
"                    <br>\n"
"                    <br>\n"
"                    Thanks.\n"
"                </p>\n"
"            "
msgstr ""
"<p>\n"
"                    Estimado/a\n"
"                    <t t-out=\"object.customer_id.name\"></t>\n"
"                    <br>\n"
"                    Su ticket\n"
"                    <t t-out=\"object.name\"></t>\n"
"                    fue cancelado debido a algunos motivos\n"
"                    <br>\n"
"                    <br>\n"
"                    Gracias.\n"
"                </p>\n"
"            "

#. module: odoo_website_helpdesk
#: model:mail.template,body_html:odoo_website_helpdesk.ticket_created
msgid ""
"<p>\n"
"                    Dear\n"
"                    <t t-out=\"object.customer_id.name\"></t>\n"
"                    <br>\n"
"                    Your Ticket\n"
"                    <t t-out=\"object.name\"></t>\n"
"                    is Created and Assigned. Kindly Wait while we're resolving your Query\n"
"                    <br>\n"
"                    <br>\n"
"                    Thanks.\n"
"                </p>\n"
"            "
msgstr ""
"<p>\n"
"                    Estimado/a\n"
"                    <t t-out=\"object.customer_id.name\"></t>\n"
"                    <br>\n"
"                    Su ticket\n"
"                    <t t-out=\"object.name\"></t>\n"
"                    fue creado y asignado. Por favor, espere mientras resolvemos su consulta\n"
"                    <br>\n"
"                    <br>\n"
"                    Gracias.\n"
"                </p>\n"
"            "

