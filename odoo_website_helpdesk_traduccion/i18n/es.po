#. module: odoo_website_helpdesk
#: model:mail.template,body_html:odoo_website_helpdesk.helpdesk_rating
msgid ""
"<p>\n"
"                    Dear\n"
"                    <t t-out=\"object.customer_id.name\"></t>\n"
"                    Your Ticket\n"
"                    <t t-out=\"object.name\"></t>\n"
"                    Is Closed\n"
"                    <br>\n"
"                    <button class=\"btn btn-info\" role=\"button\" style=\"border:1px solid black;background-color:purple;padding-x:20px;padding-y:15px;border-radius:10px; width:120px;\">\n"
"                        <a t-attf-href=\"/rating/{{object.id}}\" style=\"text-decoration:none;color:white;font-weight:bold;font-size:18px;\">\n"
"                            Rate Now\n"
"                        </a>\n"
"                    </button>\n"
"                    <br>\n"
"                    <br>\n"
"                    Thanks.\n"
"                </p>\n"
"\n"
"            "
msgstr ""
"<p>\n"
"                    Estimado/a\n"
"                    <t t-out=\"object.customer_id.name\"></t>\n"
"                    Su ticket\n"
"                    <t t-out=\"object.name\"></t>\n"
"                    fue cerrado\n"
"                    <br>\n"
"                    <button class=\"btn btn-info\" role=\"button\" style=\"border:1px solid black;background-color:purple;padding-x:20px;padding-y:15px;border-radius:10px; width:120px;\">\n"
"                        <a t-attf-href=\"/rating/{{object.id}}\" style=\"text-decoration:none;color:white;font-weight:bold;font-size:18px;\">\n"
"                            Calificar ahora\n"
"                        </a>\n"
"                    </button>\n"
"                    <br>\n"
"                    <br>\n"
"                    Gracias.\n"
"                </p>\n"
"\n"
"            "

